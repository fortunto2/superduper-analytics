{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superduper-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "observability": { "enabled": true },

  // The deployment id, used as part of every Cache API key. Without it a deploy that changes a
  // response shape serves the old shape until the TTL expires, and the page renders as if
  // there were no data — which is exactly what happened once.
  "version_metadata": { "binding": "VERSION" },

  // Declared here rather than left in the dashboard, so a deploy asserts it and the repo stays
  // the truth. This is the host every snippet points at and the one named in the privacy text
  // on every property, so it is effectively permanent — changing it later means editing every
  // site and every app.
  "routes": [{ "pattern": "analytics.superduperai.co", "custom_domain": true }],

  // Declaring routes already turns this off by default; stated explicitly so the single
  // canonical host is a decision rather than a side effect of another setting.
  "workers_dev": false,

  // The Cache API only caches on a custom domain — on *.workers.dev it silently does nothing,
  // which would quietly spend the metered SQL read budget on every dashboard refresh.

  // Hot store. Free, unlimited cardinality, SQL API — but Cloudflare DELETES it after
  // 3 months, which is exactly why the Iceberg archive below exists.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "superduper_events" }
  ],

  // What the stores report about themselves: installs, product page views, money. NOT Analytics
  // Engine, and the reason is the whole design. AE samples — every aggregate there needs
  // `sum(_sample_interval)` weighting — while Apple hands over exact daily totals that were
  // never sampled. Weighting an exact number inflates it; not weighting it in a table where
  // everything else is weighted is a trap for the next query. On top of that AE deletes after
  // 3 months, and this is the business history: it must outlive that by years.
  //
  // Tiny data — one row per app per day per metric, ~4k rows a year — which is what SQLite is
  // for. The free tier is five gigabytes.
  "d1_databases": [
    {
      "binding": "STORES",
      "database_name": "superduper-stores",
      "database_id": "51196886-11a1-4542-96ce-3c5e660f69fb"
    }
  ],

  // Once a day, a few hours after midnight UTC, because a store report for "yesterday" does not
  // exist at 00:01 — Apple restates recent days, so the job re-fetches a trailing window and
  // upserts rather than appending.
  "triggers": {
    "crons": ["0 5 * * *"]
  },

  // The binding cannot tell you the dataset name at runtime, and the SQL API needs it as a
  // table name. Declared here so it is stated once, next to the binding it must match.
  "vars": {
    "DATASET": "superduper_events"
  }

  // Secrets, set with `wrangler secret put` and never committed — see .dev.vars.example:
  //   CF_ACCOUNT_ID  the account the dataset lives in
  //   CF_API_TOKEN   an API token with Account Analytics: Read, for the SQL API

  // Cold store — added in v2. Pipelines needs Workers Paid; wire it with:
  //   wrangler pipelines setup
  // then bind the stream here as { "binding": "ARCHIVE", "pipeline": "..." } and enable the
  // catalog on the bucket:  wrangler r2 bucket catalog enable <bucket>
}
