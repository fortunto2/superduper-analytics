# Copy to .dev.vars for local development. .dev.vars is gitignored and must stay that way.
#
# In production these are Worker secrets:
#   pnpm wrangler secret put CF_ACCOUNT_ID
#   pnpm wrangler secret put CF_API_TOKEN
#
# `wrangler types` reads the KEY NAMES from .dev.vars to type `Env`, so without this file
# copied across, `make typecheck` will not know CF_API_TOKEN exists. The values here are
# placeholders and are not secret.
#
# CF_API_TOKEN needs exactly one permission: Account > Account Analytics > Read.
# Create it at https://dash.cloudflare.com/profile/api-tokens

CF_ACCOUNT_ID=0000000000000000000000000000000
CF_API_TOKEN=placeholder-not-a-real-token

# App Store Connect, for the daily store-report job. The key needs a role that can read
# REPORTS — Admin, Finance, or "Access to Reports". An App Manager key is enough for every
# release task and returns 403 for every report call, which is the first thing to check when
# the job logs nothing.
#
# ASC_PRIVATE_KEY is the .p8 file's contents, newlines and all:
#   pnpm wrangler secret put ASC_PRIVATE_KEY < AuthKey_XXXXXXXX.p8
# The vendor number is NOT the provider id — it is in ASC > Payments and Financial Reports.
ASC_KEY_ID=placeholder
ASC_ISSUER_ID=placeholder
ASC_VENDOR_NUMBER=placeholder
ASC_PRIVATE_KEY=placeholder

# Our own visits, dropped at the edge. Comma-separated, exact IPs — home, office, phone.
# A secret rather than a repo file: the repo is public and these are personal addresses.
#   pnpm wrangler secret put INTERNAL_IPS
# Find yours with: curl -s https://cloudflare.com/cdn-cgi/trace | grep '^ip='
INTERNAL_IPS=203.0.113.7,198.51.100.22

# Salt for the per-day anonymous id. Any long random string; rotating it resets all anon ids,
# which is a feature — it is the panic button if one ever needs to stop being derivable.
#   openssl rand -hex 32
ANON_SALT=replace-with-openssl-rand-hex-32

# Shared key gating the dashboard and /v1/*. Unset means those routes refuse outright — the
# read side shows the business and must never be public by accident. The real answer is
# Cloudflare Access in front of / and /v1/*; this is the stopgap until that is configured.
DASHBOARD_KEY=replace-with-openssl-rand-hex-16
